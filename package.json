{
  "name": "medics-wi-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Medics Wisconsin field inventory management — Next.js 15 + Capacitor 6",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "cap:webdir": "node -e \"const fs=require('fs');fs.mkdirSync('out',{recursive:true});fs.writeFileSync('out/index.html','<!doctype html><html><head><meta http-equiv=refresh content=\\\"0;url=https://inventory.medicswisconsin.com\\\"><title>Medics WI Inventory</title></head><body style=\\\"background:#0b1220;color:#fff;font-family:system-ui;text-align:center;padding-top:40vh\\\">Loading…</body></html>')\"",
    "cap:sync": "pnpm cap:webdir && npx cap sync",
    "cap:android": "pnpm cap:sync && npx cap open android",
    "cap:ios": "pnpm cap:sync && npx cap open ios"
  },
