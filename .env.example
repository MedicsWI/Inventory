# --- Database (Supabase Postgres) ---
# Get these from Supabase: Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth.js ---
# Generate with: openssl rand -base64 32 (or use `node -e ...` per README)
NEXTAUTH_SECRET="replace-me-with-a-32-byte-secret"
# Local dev: http://localhost:3000
# Production: https://inventory.medicswisconsin.com
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (optional, for staff SSO) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- API base URL ---
# Used by Capacitor mobile builds AND by the alert fanout to build absolute "View in app" links.
# Local dev: http://localhost:3000
# Production: https://inventory.medicswisconsin.com
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# --- Supabase Storage (for item / location photos) ---
# Project Settings -> API. URL is the same for client and server.
# The SERVICE_ROLE key bypasses Row-Level Security and is server-only — never expose.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="inventory-photos"

# --- UPC lookup (optional) ---
# Without a key we use UPCitemdb's free trial endpoint (~100 lookups/day, shared pool).
# For production sign up at https://www.upcitemdb.com and paste the user_key here.
UPCITEMDB_API_KEY=""

# --- Email alerts (Microsoft Graph via Azure AD app registration) ---
# Preferred path. Works under Conditional Access / MFA without app passwords.
# See EMAIL-AND-TEAMS-SETUP.md for the Azure setup walkthrough.
AZURE_TENANT_ID=""                    # Entra ID directory (tenant) ID
AZURE_CLIENT_ID=""                    # the app registration's application (client) ID
AZURE_CLIENT_SECRET=""                # client secret value (not the ID)
GRAPH_SEND_FROM=""                    # mailbox to send as, e.g. inventory-alerts@medicswisconsin.com
GRAPH_FROM_NAME="Medics WI Inventory" # display name for the From header

# --- Email alerts via plain SMTP (fallback / alternative) ---
# Used only if the Graph vars above are missing. Requires SMTP AUTH on the mailbox
# (M365 admin → Active users → Mail tab → Manage email apps). Won't work under Conditional Access.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --- Microsoft Teams alerts ---
# Preferred: post via the channel's built-in email address. Free, no Power Automate,
# survives Microsoft's webhook deprecations. In Teams: channel ⋮ → Get email address.
# Example: "eebc8cef.medicswisconsin.com@amer.teams.ms"
TEAMS_ALERTS_EMAIL=""

# Legacy: Power Automate / Workflows webhook URL. Kept for tenants where channel email
# is disabled. Modern Direct API URLs require OAuth and don't work without extra Azure work.
TEAMS_WEBHOOK_URL=""

# --- Web Push notifications ---
# Generate once per project: pnpm exec web-push generate-vapid-keys
# Public goes to the browser; private stays server-only. The contact email must be a real
# address that the browser's push service can reach if there's a problem with your subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="mailto:inventory-alerts@medicswisconsin.com"

# --- Vercel Cron daily check ---
# Set CRON_SECRET to a random string. The daily check endpoint requires Bearer auth
# with this value; Vercel Cron supplies it automatically (see vercel.json).
CRON_SECRET=""
